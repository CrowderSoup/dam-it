[gd_resource type="Resource" script_class="DialogueDefinition" load_steps=15 format=3]

[ext_resource type="Script" path="res://scripts/story/dialogue_line.gd" id="1_v2ow3"]
[ext_resource type="Script" path="res://scripts/story/dialogue_choice.gd" id="2_6dvoy"]
[ext_resource type="Script" path="res://scripts/story/story_effect.gd" id="3_xw20q"]
[ext_resource type="Script" path="res://scripts/story/dialogue_definition.gd" id="4_q2c4n"]
[ext_resource type="Script" path="res://scripts/story/story_condition.gd" id="5_condition"]

[sub_resource type="Resource" id="Condition_meet"]
script = ExtResource("5_condition")
type = 2
target_id = "meet_moss"

[sub_resource type="Resource" id="Resource_ksi20"]
script = ExtResource("1_v2ow3")
text = "So you are Hazel's grandkit. I remember her pools. I also remember each traveler who said this puddle would be a creek again."

[sub_resource type="Resource" id="Resource_226v6"]
script = ExtResource("3_xw20q")
target_id = "met_moss"

[sub_resource type="Resource" id="Resource_eckc0"]
script = ExtResource("2_6dvoy")
id = "earnest_stay_for_everyone"
text = "I want to bring the water back for all of us, not just me."
acknowledgement = "We will see if you still mean that when the work gets hard."
effects = Array[ExtResource("3_xw20q")]([SubResource("Resource_226v6")])

[sub_resource type="Resource" id="Resource_3t6nf"]
script = ExtResource("2_6dvoy")
id = "practical_start_together"
tone = 1
text = "One fixed dam is a start. Let us find out together."
acknowledgement = "A clear plan. I can work with that."
effects = Array[ExtResource("3_xw20q")]([SubResource("Resource_226v6")])

[sub_resource type="Resource" id="Resource_4qg18"]
script = ExtResource("2_6dvoy")
id = "playful_lucky_you"
tone = 2
text = "Good news! I know a fine dam builder."
acknowledgement = "Big words. Let us see you back them up."
effects = Array[ExtResource("3_xw20q")]([SubResource("Resource_226v6")])

[sub_resource type="Resource" id="Resource_kv0pn"]
script = ExtResource("1_v2ow3")
text = "One new beaver cannot fix it all. Why stay when you came to build a home just for yourself?"
choices = Array[ExtResource("2_6dvoy")]([SubResource("Resource_eckc0"), SubResource("Resource_3t6nf"), SubResource("Resource_4qg18")])

[sub_resource type="Resource" id="Resource_ique5"]
script = ExtResource("3_xw20q")
type = 2
target_id = "gather_starter_wood"

[sub_resource type="Resource" id="Effect_complete_meet"]
script = ExtResource("3_xw20q")
type = 4
target_id = "meet_moss"

[sub_resource type="Resource" id="Resource_em67l"]
script = ExtResource("1_v2ow3")
text = "Fine. If you will stay, gather some wood. Show me that I can trust your word."
effects = Array[ExtResource("3_xw20q")]([SubResource("Effect_complete_meet"), SubResource("Resource_ique5")])

[resource]
script = ExtResource("4_q2c4n")
id = "moss_intro"
speaker = "moss"
condition = SubResource("Condition_meet")
lines = Array[ExtResource("1_v2ow3")]([SubResource("Resource_ksi20"), SubResource("Resource_kv0pn"), SubResource("Resource_em67l")])
