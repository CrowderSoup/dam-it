[gd_resource type="Resource" script_class="DialogueDefinition" load_steps=5 format=3]

[ext_resource type="Script" path="res://scripts/story/dialogue_definition.gd" id="1"]
[ext_resource type="Script" path="res://scripts/story/dialogue_line.gd" id="2"]
[ext_resource type="Script" path="res://scripts/story/story_condition.gd" id="3"]

[sub_resource type="Resource" id="Condition_read"]
script = ExtResource("3")
type = 2
target_id = "read_willowbend_water"

[sub_resource type="Resource" id="Line_one"]
script = ExtResource("2")
text = "That is enough wood to begin. The old dam failed where the current pushed hardest, not where the gap looked widest."

[sub_resource type="Resource" id="Line_two"]
script = ExtResource("2")
text = "Hazel used a reed-marked post beside the channel. Read the water there before you close the middle gap."

[resource]
script = ExtResource("1")
id = "moss_supplies_ready"
speaker = "moss"
condition = SubResource("Condition_read")
lines = Array[ExtResource("2")]([SubResource("Line_one"), SubResource("Line_two")])

